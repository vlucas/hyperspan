{
  "name": "@hyperspan/vite-plugin",
  "version": "2.0.0-alpha.1",
  "description": "Vite plugin for Hyperspan apps",
  "type": "module",
  "public": true,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./islands": {
      "types": "./src/islands.ts",
      "default": "./src/islands.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperspan/framework": "^2.0.0-alpha.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
