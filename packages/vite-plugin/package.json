{
  "name": "@hyperspan/vite-plugin",
  "version": "2.0.0-alpha.16",
  "description": "Vite plugin for Hyperspan apps",
  "type": "module",
  "public": true,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./islands": {
      "types": "./src/islands.ts",
      "default": "./src/islands.ts"
    },
    "./tsconfig-aliases": {
      "types": "./src/tsconfig-aliases.ts",
      "default": "./src/tsconfig-aliases.ts"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperspan/adapter-node": "^2.0.0-alpha.16",
    "@hyperspan/framework": "^2.0.0-alpha.16",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "tiny-jsonc": "^1.0.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
