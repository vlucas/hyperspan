{
  "name": "@hyperspan/vite-plugin",
  "version": "2.0.1",
  "description": "Vite plugin for Hyperspan apps",
  "type": "module",
  "public": true,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./islands": {
      "types": "./src/islands.ts",
      "default": "./dist/islands.js"
    },
    "./tsconfig-aliases": {
      "types": "./src/tsconfig-aliases.ts",
      "default": "./dist/tsconfig-aliases.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-node-packages.mjs vite-plugin",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperspan/adapter-node": "^2.0.1",
    "@hyperspan/framework": "^2.0.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "tiny-jsonc": "^1.0.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
