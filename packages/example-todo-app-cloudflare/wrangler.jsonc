{
  "name": "hyperspan-todo-cloudflare",
  "main": "./dist/server.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "TODO_KV",
      // Required for deploy — Wrangler will try to create a namespace if this is missing.
      // Create one: wrangler kv namespace create TODO_KV
      // Or list existing: wrangler kv namespace list
      "id": "3a8ab2d9f9bd42c7a0feb5e5235c3257"
    }
  ],
  // >>> hyperspan:css-aliases (auto-generated — do not edit)
  "alias": {
    "../styles/globals.css": "../adapter-cloudflare/stubs/empty.css",
    "app/styles/globals.css": "../adapter-cloudflare/stubs/empty.css"
  }
  // <<< hyperspan:css-aliases
}
