{
  "name": "@hyperspan/html",
  "version": "2.0.0",
  "description": "Hyperspan HTML Templates",
  "type": "module",
  "main": "./dist/html.js",
  "types": "./src/html.ts",
  "exports": {
    ".": {
      "types": "./src/html.ts",
      "default": "./dist/html.js"
    }
  },
  "public": true,
  "files": [
    "dist",
    "src",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "author": "Vance Lucas <vance@vancelucas.com>",
  "license": "BSD-3-Clause",
  "keywords": [
    "template",
    "template literal",
    "html template",
    "streaming template"
  ],
  "homepage": "https://www.hyperspan.dev/docs/html",
  "bugs": {
    "url": "https://github.com/vlucas/hyperspan/issues"
  },
  "scripts": {
    "build": "node ../../scripts/build-node-packages.mjs html",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlucas/hyperspan.git"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "prettier": "^3.2.5",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {}
}
