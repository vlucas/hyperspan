{
  "name": "@hyperspan/adapter-cloudflare",
  "version": "2.0.0-alpha.13",
  "description": "Cloudflare Workers adapter for Hyperspan",
  "type": "module",
  "public": true,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "src/index.ts",
