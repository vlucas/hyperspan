{
  "name": "@hyperspan/framework",
  "version": "2.0.0-alpha.4",
  "description": "Hyperspan Web Framework",
  "type": "module",
  "main": "src/server.ts",
  "types": "src/server.ts",
  "public": true,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "default": "./src/middleware.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./routes": {
      "types": "./src/register-routes.ts",
      "default": "./src/register-routes.ts"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "default": "./src/layout.ts"
    },
    "./client/css": {
      "types": "./src/client/css.ts",
      "default": "./src/client/css.ts"
    },
    "./client/js": {
      "types": "./src/client/js.ts",
      "default": "./src/client/js.ts"
    },
    "./client/manifest": {
      "types": "./src/client/manifest.ts",
      "default": "./src/client/manifest.ts"
    },
    "./actions": {
      "types": "./src/actions.ts",
      "default": "./src/actions.ts"
    },
    "./ssr/install-server-dom-mock": {
      "types": "./src/ssr/install-server-dom-mock.ts",
      "default": "./src/ssr/install-server-dom-mock.ts"
    },
    "./ssr/mock-dom": {
      "types": "./src/ssr/mock-dom.ts",
      "default": "./src/ssr/mock-dom.ts"
    },
    "./client/_hs/hyperspan-streaming.client.ts": {
      "default": "./src/client/_hs/hyperspan-streaming.client.ts"
    },
    "./client/_hs/hyperspan-actions.client.ts": {
      "default": "./src/client/_hs/hyperspan-actions.client.ts"
    },
    "./client/_hs/hyperspan-scripts.client.ts": {
      "default": "./src/client/_hs/hyperspan-scripts.client.ts"
    }
  },
  "author": "Vance Lucas <vance@vancelucas.com>",
  "license": "BSD-3-Clause",
  "keywords": [
    "framework",
    "node",
    "vite",
    "web framework",
    "javascript",
    "typescript",
    "streaming",
    "hypermedia"
  ],
  "homepage": "https://www.hyperspan.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlucas/hyperspan.git"
  },
  "bugs": {
    "url": "https://github.com/vlucas/hyperspan/issues"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.0",
    "prettier": "^3.5.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hyperspan/html": "^2.0.0-alpha.4",
    "debug": "^4.4.3",
    "isbot": "^5.1.32",
    "zod": "^4.4.3"
  }
}
