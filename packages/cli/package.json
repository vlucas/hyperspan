{
  "name": "hyperspan",
  "version": "2.0.0-alpha.20",
  "description": "Hyperspan CLI - for @hyperspan/framework",
  "type": "module",
  "public": true,
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "main": "src/index.ts",
