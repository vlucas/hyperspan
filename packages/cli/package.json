  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperspan/adapter-node": "^2.0.0-alpha.20",
    "@hyperspan/framework": "^2.0.0-alpha.20",
    "@hyperspan/plugin-preact": "^2.0.0-alpha.20",
    "@hyperspan/plugin-svelte": "^2.0.0-alpha.20",
    "@hyperspan/plugin-vue": "^2.0.0-alpha.20",
    "@hyperspan/vite-plugin": "^2.0.0-alpha.20",
    "commander": "^14.0.3",
    "degit": "^2.8.4",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "tsx": "^4.20.5",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/degit": "^2.8.6",
